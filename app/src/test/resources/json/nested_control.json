{
  "scope": {
    "decls": [
      { "name": "rows", "spec": "var" },
      { "name": "cols", "spec": "var" },
      { "name": "count", "spec": "var" },
      { "name": "i", "spec": "var" },
      { "name": "j", "spec": "var" }
    ],
    "body": {
      "seq": {
        "left": { "assn": { "dst": "j", "src": { "const": 0 } } },
        "right": {
          "seq": {
            "left": { "assn": { "dst": "i", "src": { "const": 0 } } },
            "right": {
              "seq": {
                "left": { "assn": { "dst": "count", "src": { "const": 0 } } },
                "right": {
                  "seq": {
                    "left": {
                      "assn": { "dst": "cols", "src": { "const": 0 } }
                    },
                    "right": {
                      "seq": {
                        "left": {
                          "assn": { "dst": "rows", "src": { "const": 0 } }
                        },
                        "right": {
                          "seq": {
                            "left": { "read": "rows" },
                            "right": {
                              "seq": {
                                "left": { "read": "cols" },
                                "right": {
                                  "seq": {
                                    "left": {
                                      "assn": {
                                        "dst": "count",
                                        "src": { "const": 0 }
                                      }
                                    },
                                    "right": {
                                      "seq": {
                                        "left": {
                                          "seq": {
                                            "left": {
                                              "assn": {
                                                "dst": "i",
                                                "src": { "const": 0 }
                                              }
                                            },
                                            "right": {
                                              "while": {
                                                "cond": {
                                                  "binop": "<",
                                                  "left": { "var": "i" },
                                                  "right": { "var": "rows" }
                                                },
                                                "body": {
                                                  "seq": {
                                                    "left": {
                                                      "seq": {
                                                        "left": {
                                                          "assn": {
                                                            "dst": "j",
                                                            "src": {
                                                              "const": 0
                                                            }
                                                          }
                                                        },
                                                        "right": {
                                                          "while": {
                                                            "cond": {
                                                              "binop": "<",
                                                              "left": {
                                                                "var": "j"
                                                              },
                                                              "right": {
                                                                "var": "cols"
                                                              }
                                                            },
                                                            "body": {
                                                              "seq": {
                                                                "left": {
                                                                  "if": {
                                                                    "cond": {
                                                                    "binop": "==",
                                                                    "left": {
                                                                    "binop": "%",
                                                                    "left": {
                                                                    "binop": "+",
                                                                    "left": {
                                                                    "var": "i"
                                                                    },
                                                                    "right": {
                                                                    "var": "j"
                                                                    }
                                                                    },
                                                                    "right": {
                                                                    "const": 2
                                                                    }
                                                                    },
                                                                    "right": {
                                                                    "const": 0
                                                                    }
                                                                    },
                                                                    "then": {
                                                                    "assn": {
                                                                    "dst": "count",
                                                                    "src": {
                                                                    "binop": "+",
                                                                    "left": {
                                                                    "var": "count"
                                                                    },
                                                                    "right": {
                                                                    "const": 1
                                                                    }
                                                                    }
                                                                    }
                                                                    },
                                                                    "else": "skip"
                                                                  }
                                                                },
                                                                "right": {
                                                                  "assn": {
                                                                    "dst": "j",
                                                                    "src": {
                                                                    "binop": "+",
                                                                    "left": {
                                                                    "var": "j"
                                                                    },
                                                                    "right": {
                                                                    "const": 1
                                                                    }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    },
                                                    "right": {
                                                      "assn": {
                                                        "dst": "i",
                                                        "src": {
                                                          "binop": "+",
                                                          "left": {
                                                            "var": "i"
                                                          },
                                                          "right": {
                                                            "const": 1
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        },
                                        "right": {
                                          "write": { "var": "count" }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
