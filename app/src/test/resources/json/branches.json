{
  "seq": {
    "left": {
      "read": "x"
    },
    "right": {
      "if": {
        "cond": {
          "binop": ">",
          "left": {
            "var": "x"
          },
          "right": {
            "const": 10
          }
        },
        "then": {
          "write": {
            "const": 100
          }
        },
        "else": {
          "if": {
            "cond": {
              "binop": "==",
              "left": {
                "var": "x"
              },
              "right": {
                "const": 10
              }
            },
            "then": {
              "write": {
                "const": 200
              }
            },
            "else": {
              "write": {
                "const": 300
              }
            }
          }
        }
      }
    }
  }
}
