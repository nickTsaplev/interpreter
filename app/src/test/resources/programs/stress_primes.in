{
  read(limit);
  count = 0;
  sum = 0;
  checksum = 0;

  for (candidate = 2; candidate <= limit; candidate += 1) {
    divisor = 2;
    isPrime = 1;

    while ((divisor * divisor <= candidate) && isPrime) {
      if (candidate % divisor == 0)
        isPrime = 0;
      else
        divisor += 1;
    }

    if (isPrime) {
      count += 1;
      sum += candidate;
      checksum = (checksum * 31 + candidate) % 100000;

      if (candidate % 10 == 1 !! candidate == 2)
        write(candidate);
      else
        skip;
    } else {
      skip;
    }
  }

  write(count);
  write(sum);
  write(checksum);
}
